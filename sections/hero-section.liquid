<style>
    .content-hero-home{
        background-image: url('{{ 'hero_img.jpg' |  asset_url }}');
    }
    @media screen and (max-width: 768px) {
        .content-hero-home{
            background-image: url('{{ 'hero_img_sm.jpg' |  asset_url }}');
        }
    }
</style>
<div class="content-hero-home img-center sm:mt-[-9rem] mt-[-6rem] relative -z-0 pt-[20rem]">
    <div class="text-content flex justify-center">
        <div class="w-[342px] relative">
            <h1 class="title-white !text-[#F4D5C4] relative z-20 leading-[1]">
                {{ section.settings.title-hero-section }}
            </h1>
            <img class="quote absolute top-[40%] right-0" src="{{ 'quote.svg' |  asset_url }}" alt="quote" width="auto" height="auto">
            <span class="h-[25px] w-full bg-_red_color absolute bottom-[-4px] left-0 z-10"></span>
        </div>
    </div>
    <div class="btn-content flex justify-center mt-[42px] pb-[28px]">
        <a href="/collections" class="btn">Viens tester !</a>
    </div>
    <div class="marqui-text w-full overflow-hidden">
        <div class="marquee-scroll flex gap-[12px] font-rubik text-lg font-normal text-_red_color bg-white pt-[4px]">
            <div class="marquee-chield flex gap-[12px] items-center">
                {{ section.settings.text-de-defilement }}
            </div>
            <div class="flex gap-[12px] items-center">
                {{ section.settings.text-de-defilement }}
            </div>
        </div>
    </div>
    <div class="wave-hero absolute bottom-0 right-0 -z-10">
        <img class="w-full sm:block hidden" src="{{ 'wave_hero.svg' |  asset_url }} " alt="wave-hero" height="auto" width="auto">
        <img class="w-full sm:hidden block" src="{{ 'wave_hero_mobile.svg' |  asset_url }} " alt="wave-hero" height="auto" width="auto">
    </div>
</div>

{% comment %} <pre class="bg-white">
    {{ collections | json }}
</pre> {% endcomment %}

{% schema %}
    {
      "name": "Hero section",
      "tag": "section",
      "class": "hero-section",
      "settings": [
        {
            "type": "html",
            "id": "title-hero-section",
            "label": "Titre du hero",
            "default": "Le Sain, <br> Le Goût, <br> Et c’est tout <br>"
        },
        {
            "type": "html",
            "id": "text-de-defilement",
            "label": "Text de defilement",
            "default": "<span>Riche en fibre diététique</span><span>Riche en fibre diététique 2</span><span>Riche en fibre diététique 3</span>"
        }
      ]
    }
{% endschema %}